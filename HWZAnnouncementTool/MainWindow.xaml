<Window x:Class="HWZAnnouncementTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HWZ 公告编辑器"
        Height="760" Width="1060"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════ 顶部 ═════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="公告编辑器" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                           Text="编写一次，发布到仓库，所有打开 HWZ 代码互换工坊的用户都会看到。" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="RepoText" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                <TextBlock Text="署名：HWZ工作室" Style="{StaticResource Muted}" Margin="0,3,0,0"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- ═════════ 主体 ═════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 编辑区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="标题" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <TextBox x:Name="TitleBox" Style="{StaticResource FieldBox}" MaxLength="60"
                                 TextChanged="Editor_Changed" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="级别（影响客户端弹窗配色）" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                            <ComboBox x:Name="LevelBox" Style="{StaticResource ModernCombo}"
                                      SelectionChanged="Editor_Changed">
                                <ComboBoxItem Content="公告 · 常规信息（青绿）" Tag="info" IsSelected="True" />
                                <ComboBoxItem Content="注意 · 需要留意（橙色）" Tag="warn" />
                                <ComboBoxItem Content="重要 · 强提醒（红色）" Tag="important" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,9">
                            <CheckBox x:Name="EnabledCheck" Style="{StaticResource ModernCheck}"
                                      Content="启用公告" IsChecked="True" Checked="Editor_Changed" Unchecked="Editor_Changed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="正文" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="CharCount" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBox x:Name="ContentBox" Style="{StaticResource CodeBox}" Height="Auto"
                                 FontFamily="{DynamicResource UiFont}" FontSize="13"
                                 TextChanged="Editor_Changed" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="按钮文字（可选）" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="ActionTextBox" Style="{StaticResource FieldBox}" MaxLength="20"
                                     TextChanged="Editor_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="按钮链接（可选，http/https）" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="ActionUrlBox" Style="{StaticResource FieldBox}"
                                     TextChanged="Editor_Changed" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 预览 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="客户端预览" Style="{StaticResource H2}" Margin="18,16,18,4" />
                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" Margin="18,38,18,10"
                               Text="与用户在软件里看到的一致" />

                    <!-- 模拟弹窗 -->
                    <Border Grid.Row="1" Margin="18,0,18,18" CornerRadius="10"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="PreviewBar" Grid.Row="0" Height="4" CornerRadius="10,10,0,0"
                                    Background="{DynamicResource AccentBrush}" />

                            <StackPanel Grid.Row="1" Margin="18,14,18,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border x:Name="PreviewBadge" CornerRadius="5" Padding="7,1" BorderThickness="1"
                                            BorderBrush="{DynamicResource AccentBrush}">
                                        <TextBlock x:Name="PreviewBadgeText" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Text="公告" />
                                    </Border>
                                    <TextBlock x:Name="PreviewTime" Style="{StaticResource Muted}" FontSize="11"
                                               Margin="8,2,0,0" />
                                </StackPanel>

                                <TextBlock x:Name="PreviewTitle" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                          Margin="18,10,18,0">
                                <TextBlock x:Name="PreviewContent" FontSize="12.5" TextWrapping="Wrap"
                                           LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </ScrollViewer>

                            <Grid Grid.Row="3" Margin="18,14,18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="PreviewAction" Grid.Column="0" CornerRadius="7" Padding="10,5"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Visibility="Collapsed" HorizontalAlignment="Left">
                                    <TextBlock x:Name="PreviewActionText" FontSize="11.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>

                                <Border Grid.Column="1" CornerRadius="7" Padding="12,5" Margin="8,0,0,0"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="我知道了" FontSize="11.5" Foreground="White" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═════════ 发布设置 ═════════ -->
        <Expander Grid.Row="2" Margin="0,12,0,0" IsExpanded="False"
                  Header="发布设置（仓库 / 分支 / Token）">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="仓库（owner/repo）" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="RepoBox" Style="{StaticResource FieldBox}" TextChanged="Publish_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="分支" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="BranchBox" Style="{StaticResource FieldBox}" TextChanged="Publish_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Personal Access Token" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                            <PasswordBox x:Name="TokenBox" MinHeight="36" Padding="10,8" FontSize="13"
                                         PasswordChanged="Publish_Changed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="需要 Contents: Read and write 权限。Token 以 Base64 形式保存在本机配置文件，仅用于免去重复输入，请勿在公用电脑上保存。" />

                        <Button Grid.Column="1" Content="清除已保存的 Token" Style="{StaticResource GhostButton}"
                                Padding="12,6" FontSize="12" Margin="12,0,0,0" Click="ClearToken_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>

        <!-- ═════════ 底部操作 ═════════ -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Text="就绪" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ReadBtn" Content="读取线上公告" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="Read_Click" />
                <Button x:Name="TrafficBtn" Content="访问统计" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="Traffic_Click" />
                <Button x:Name="ExportBtn" Content="导出 JSON" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="Export_Click" />
                <Button x:Name="PublishBtn" Content="发布到 GitHub" Style="{StaticResource PrimaryButton}"
                        Click="Publish_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
