<Window x:Class="HWZAnnouncementTool.Views.TrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仓库访问统计"
        Height="890" Width="980"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════ 顶部 ═════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="仓库访问统计" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                           Text="GitHub 流量数据 · 最近 14 天，叠加本机累计存档" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="RepoTitle" Style="{StaticResource BaseText}" FontWeight="SemiBold"
                           HorizontalAlignment="Right" Text="—" />
                <TextBlock Text="署名：HWZ工作室" Style="{StaticResource Muted}" Margin="0,3,0,0"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- ═════════ 工具栏 ═════════ -->
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="RepoInput" Grid.Column="0" Style="{StaticResource FieldBox}"
                     Margin="0,0,8,0" KeyDown="RepoInput_KeyDown" />

            <Button x:Name="RefreshBtn" Grid.Column="1" Content="刷新数据"
                    Style="{StaticResource PrimaryButton}" Padding="16,9" Click="Refresh_Click" />

            <Button x:Name="OpenRepoBtn" Grid.Column="2" Content="在浏览器打开"
                    Style="{StaticResource GhostButton}" Padding="13,8" Margin="8,0,0,0"
                    Click="OpenRepo_Click" />

            <TextBlock x:Name="PublicStats" Grid.Column="4" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="—" />
        </Grid>

        <!-- 权限 / 错误提示（固定位置，避免被滚动内容遮蔽） -->
        <Border x:Name="HintCard" Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource WarnBrush}">
            <TextBlock x:Name="HintText" Style="{StaticResource BaseText}" FontSize="12"
                       TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" />
        </Border>

        <!-- ═════════ 内容 ═════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- 指标卡 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="UniqueValue" Text="—" FontSize="27" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="累计独立访客" Style="{StaticResource BaseText}" FontSize="12.5"
                                       Margin="0,2,0,0" />
                            <TextBlock x:Name="UniqueNote" Style="{StaticResource Muted}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Text="—" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="TotalViewValue" Text="—" FontSize="27" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="累计浏览次数" Style="{StaticResource BaseText}" FontSize="12.5"
                                       Margin="0,2,0,0" />
                            <TextBlock x:Name="TotalViewNote" Style="{StaticResource Muted}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Text="—" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="RecentUniqueValue" Text="—" FontSize="27" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="近 14 天独立访客" Style="{StaticResource BaseText}" FontSize="12.5"
                                       Margin="0,2,0,0" />
                            <TextBlock x:Name="RecentUniqueNote" Style="{StaticResource Muted}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Text="—" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,13">
                        <StackPanel>
                            <TextBlock x:Name="CloneValue" Text="—" FontSize="27" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="近 14 天克隆" Style="{StaticResource BaseText}" FontSize="12.5"
                                       Margin="0,2,0,0" />
                            <TextBlock x:Name="CloneNote" Style="{StaticResource Muted}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Text="—" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 柱状图 -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="近 14 天每日浏览" Style="{StaticResource H2}" />
                            <TextBlock x:Name="ChartHint" Style="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="—" />
                        </Grid>

                        <Grid x:Name="ChartGrid" Height="140" Margin="0,12,0,0" />

                        <TextBlock x:Name="ChartEmpty" Style="{StaticResource Muted}" Margin="0,16,0,8"
                                   TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="暂无流量数据。请填写具备该仓库 Administration 读权限的 Token 后刷新。" />
                    </StackPanel>
                </Border>

                <!-- 来源与入口 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="热门来源" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,10"
                                       Text="访客从哪里点进来（近 14 天）" />
                            <StackPanel x:Name="ReferrersPanel" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="热门入口" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,10"
                                       Text="仓库里被访问最多的页面（近 14 天）" />
                            <StackPanel x:Name="PathsPanel" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 口径说明 -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="数据口径" Style="{StaticResource H2}" FontSize="13" />

                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,7,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="· GitHub Traffic 只保留最近 14 天，更早数据无法回溯，「近 14 天」为官方口径。" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="· 「累计」由本机存档逐日相加，起点约 14 天前；跨天重复访问会重复计入，故为下界估计，换机后重新累积。" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="· 星标、Fork、关注为公开数据，无需权限。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════ 底部 ═════════ -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Text="就绪" />

            <Button x:Name="ClearBtn" Grid.Column="1" Content="清空本机累计"
                    Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" Margin="12,0,8,0"
                    Click="ClearArchive_Click" />

            <Button Grid.Column="2" Content="关闭" Style="{StaticResource GhostButton}"
                    Padding="18,7" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
