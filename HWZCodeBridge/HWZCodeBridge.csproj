<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HWZCodeBridge</AssemblyName>
    <RootNamespace>HWZCodeBridge</RootNamespace>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <Product>HWZ 代码互换工坊</Product>
    <Company>HWZ工作室</Company>
    <Authors>HWZ工作室</Authors>
    <Copyright>Copyright © 2026 HWZ工作室</Copyright>
    <Description>主流代码互换 + 源码编译为可执行文件的一体化工具</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" Condition="false" />
  </ItemGroup>

</Project>
