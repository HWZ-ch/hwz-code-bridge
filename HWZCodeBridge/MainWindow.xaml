<Window x:Class="HWZCodeBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HWZ 代码互换工坊"
        Height="780" Width="1220"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource UiFont}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═════════ 侧栏 ═════════ -->
        <Border Grid.Column="0" Background="{DynamicResource NavBgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 顶部品牌 -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="HW" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="代码互换工坊" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Code Bridge" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 底部署名 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,18">
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="署名：HWZ工作室" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 导航 -->
                <StackPanel Margin="0,4,0,0">
                    <RadioButton x:Name="NavConvert" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="⇄   代码互换" IsChecked="True" Tag="convert"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavBuild" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="⚡   编译为 EXE" Tag="build" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="◆   工具中心" Tag="tools" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="▤   转换记录" Tag="history" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="!    BUG 日志" Tag="log" Checked="Nav_Checked" />
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="18,10,18,10" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="⚙   设置" Tag="settings" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="i    关于" Tag="about" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ 内容区 ═════════ -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>
