<Window x:Class="HWZCodeBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HWZ 代码互换工坊"
        Height="780" Width="1220"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource UiFont}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═════════ 侧栏 ═════════ -->
        <Border Grid.Column="0" Background="{DynamicResource NavBgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 顶部品牌 -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="HW" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="代码互换工坊" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Code Bridge" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 底部署名 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,18">
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="VersionLabel" Text="v1.0.2" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="署名：HWZ工作室" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 导航 -->
                <StackPanel Margin="0,4,0,0">
                    <RadioButton x:Name="NavConvert" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="⇄   代码互换" IsChecked="True" Tag="convert"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavBuild" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="⚡   编译为 EXE" Tag="build" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="◆   工具中心" Tag="tools" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="▤   转换记录" Tag="history" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="!    BUG 日志" Tag="log" Checked="Nav_Checked" />
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="18,10,18,10" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="⚙   设置" Tag="settings" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="i    关于" Tag="about" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ 内容区 ═════════ -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost" />
        </Grid>

        <!-- ═════════ 顶部公告条（普通 / 注意级）═════════ -->
        <Border x:Name="NoticeBar" Grid.Column="0" Grid.ColumnSpan="2"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,14,0,0" MinWidth="340" MaxWidth="640"
                CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                Visibility="Collapsed" Panel.ZIndex="200"
                Cursor="Hand"
                MouseLeftButtonUp="NoticeBar_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NoticeTransform" Y="-90" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#0A2020" />
            </Border.Effect>

            <Grid Margin="16,11,10,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="NoticeDot" Grid.Column="0" Width="8" Height="8"
                         Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,10,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NoticeTitle" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="NoticeChevron" Text="▾" FontSize="10" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer x:Name="NoticeSummaryScroll" Margin="0,4,0,0" MaxHeight="38"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <TextBlock x:Name="NoticeSummary" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </ScrollViewer>
                </StackPanel>

                <Button x:Name="NoticeDetailBtn" Grid.Column="2" Content="详情"
                        Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11.5"
                        Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="NoticeDetail_Click" />

                <Button Grid.Column="3" Content="✕" Style="{StaticResource GhostButton}"
                        Padding="9,4" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                        Click="NoticeClose_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
