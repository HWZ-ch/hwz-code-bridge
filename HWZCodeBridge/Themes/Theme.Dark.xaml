<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：仅覆盖颜色资源，样式定义复用 Theme.xaml（全部使用 DynamicResource 引用） -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#0F1516" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#182022" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1E282A" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B3739" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7EFEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A6A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2CC5BF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#16312F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1B3A38" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F26B6F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="NavBgBrush" Color="#131A1B" />

</ResourceDictionary>
