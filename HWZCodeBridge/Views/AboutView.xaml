<UserControl x:Class="HWZCodeBridge.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="关于" Style="{StaticResource H1}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

                <!-- 品牌卡 -->
                <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="58" Height="58" CornerRadius="16"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                            <TextBlock Text="HW" Foreground="White" FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="HWZ 代码互换工坊" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                                <Button Content="检查更新" Style="{StaticResource GhostButton}"
                                        Padding="10,4" FontSize="11.5" Margin="12,0,0,0"
                                        Click="CheckUpdate_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border CornerRadius="6" Padding="10,4" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="署名：HWZ工作室" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border CornerRadius="6" Padding="10,4" Margin="8,0,0,0"
                                        Background="{DynamicResource SurfaceAltBrush}">
                                    <TextBlock Text="Windows 桌面端 · .NET 8 WPF" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 功能 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="它做什么" Style="{StaticResource H2}" Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap" LineHeight="22"
                                   Text="一、主流代码互换：Python、JavaScript、TypeScript、C#、Java、C++ 六种语言任意两两转换，自动完成缩进块与花括号块的互译，并给出需要人工复核的提示。" />
                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"
                                   Text="二、编译为可执行文件：调用本机已安装的 PyInstaller、Nuitka、.NET SDK、pkg、GCC、jpackage 等工具，把源码直接打包成 Windows exe。" />
                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"
                                   Text="三、工具中心：集中登记第三方工具的名称、用途、来源组织、官方主页与许可证，支持用户自行接入更多工具。" />
                        <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"
                                   Text="四、可追溯：转换记录、设置与 BUG 日志全部保存在本地，随时可导出 CSV 记录与诊断报告。" />
                    </StackPanel>
                </Border>

                <!-- 第三方声明 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第三方工具与来源声明" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="本软件不内嵌上述工具，仅在用户主动触发时通过命令行调用本机安装的版本。下列信息用于标明来源，许可证细则以各项目官方页面为准。" />

                        <ItemsControl x:Name="ToolList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding SourceNote, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding License, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Homepage}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 免责 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="使用须知" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"
                                   Text="代码互换基于语法规则重写，不做完整语义分析与类型推导。对于涉及反射、元编程、异步调度、装饰器、运算符重载等特性的代码，转换结果可能无法直接编译或运行，请务必人工复核后再投入使用。" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"
                                   Text="编译功能只负责调度本机工具链，不对生成物的安全性、合规性作任何担保。请确保你对所编译的代码拥有相应权利。" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,14"
                           Text="HWZ 代码互换工坊 · 由 HWZ工作室 设计与开发" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
