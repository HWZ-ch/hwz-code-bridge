<UserControl x:Class="HWZCodeBridge.Views.BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <DataTemplate x:Key="NamedItemTemplate">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="编译为可执行文件" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="调用本机已安装的第三方工具，把源码打包成 Windows exe。把源文件拖入窗口即可快速填入路径。" />
        </StackPanel>

        <!-- 配置 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 源文件 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="源文件" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourcePathBox" Grid.Column="0" Style="{StaticResource FieldBox}"
                                 TextChanged="SourcePathBox_TextChanged" />
                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource GhostButton}"
                                Padding="12,7" Margin="8,0,0,0" Click="BrowseSource_Click" />
                    </Grid>
                </StackPanel>

                <!-- 源语言 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="源语言" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ComboBox x:Name="LangBox" Style="{StaticResource ModernCombo}"
                              ItemTemplate="{StaticResource NamedItemTemplate}"
                              SelectionChanged="LangBox_SelectionChanged" />
                </StackPanel>

                <!-- 输出目录 -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="输出目录" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputDirBox" Grid.Column="0" Style="{StaticResource FieldBox}" />
                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource GhostButton}"
                                Padding="12,7" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                        <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}"
                                Padding="12,7" Margin="8,0,0,0" Click="OpenOutput_Click" />
                    </Grid>
                </StackPanel>

                <!-- 右列：打包工具 -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="打包工具" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ComboBox x:Name="ToolBox" Style="{StaticResource ModernCombo}"
                              ItemTemplate="{StaticResource NamedItemTemplate}"
                              SelectionChanged="ToolBox_SelectionChanged" />
                </StackPanel>

                <!-- 产物名 -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="产物名称" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <TextBox x:Name="OutputNameBox" Style="{StaticResource FieldBox}" />
                </StackPanel>

                <!-- 架构 -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="目标架构" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ComboBox x:Name="ArchBox" Style="{StaticResource ModernCombo}">
                        <ComboBoxItem Content="win-x64（64 位，推荐）" Tag="win-x64" IsSelected="True" />
                        <ComboBoxItem Content="win-x86（32 位）" Tag="win-x86" />
                        <ComboBoxItem Content="win-arm64（ARM64）" Tag="win-arm64" />
                    </ComboBox>
                </StackPanel>

                <!-- 工具来源说明（跨列，避免挤压左右两列的高度） -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,2,0,0"
                        Padding="12,10" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
                    <TextBlock x:Name="ToolInfo" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               LineHeight="19" />
                </Border>
            </Grid>
        </Border>

        <!-- 操作条 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="UpxCheck" Grid.Column="0" Style="{StaticResource ModernCheck}"
                          Content="生成后用 UPX 压缩体积（需已安装 UPX）" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" IsEnabled="False" Click="Cancel_Click" />
                    <Button x:Name="BuildBtn" Content="开始打包" Style="{StaticResource PrimaryButton}"
                            Click="Build_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="编译输出" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="BuildStatus" Grid.Column="1" Style="{StaticResource Muted}"
                               Margin="10,0,0,0" VerticalAlignment="Center" Text="就绪" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="清空" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Click="ClearLog_Click" />
                    </StackPanel>
                </Grid>

                <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource CodeBox}"
                         IsReadOnly="True" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
