<UserControl x:Class="HWZCodeBridge.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 用 ItemTemplate 而非 DisplayMemberPath：后者在自定义 ComboBox 模板下不会作用于选中区 -->
        <DataTemplate x:Key="LanguageTemplate">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="代码互换" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                       Text="支持 Python、JavaScript、TypeScript、C#、Java、C++ 六种语言的任意双向转换。支持直接把代码文件拖入窗口。" />
        </StackPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="源语言" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SourceLangBox" Grid.Column="1" Width="132"
                          Style="{StaticResource ModernCombo}" ItemTemplate="{StaticResource LanguageTemplate}"
                          SelectionChanged="SourceLangBox_SelectionChanged" />

                <Button Grid.Column="2" Content="⇄" Width="36" Height="34" Margin="10,0"
                        Style="{StaticResource GhostButton}" Padding="0" FontSize="15"
                        ToolTip="交换源语言与目标语言" Click="Swap_Click" />

                <TextBlock Grid.Column="3" Text="目标语言" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="TargetLangBox" Grid.Column="4" Width="132"
                          Style="{StaticResource ModernCombo}" ItemTemplate="{StaticResource LanguageTemplate}"
                          SelectionChanged="TargetLangBox_SelectionChanged" />

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="清空" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Clear_Click" />
                    <Button Content="开始转换" Style="{StaticResource PrimaryButton}" Click="Convert_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 双栏编辑区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 源码 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="源代码" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SourceMeta" Grid.Column="1" Style="{StaticResource Muted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" Text="0 行" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="示例" Style="{StaticResource GhostButton}" Padding="10,5"
                                    FontSize="12" Margin="0,0,6,0" Click="LoadSample_Click" />
                            <Button Content="打开文件" Style="{StaticResource GhostButton}" Padding="10,5"
                                    FontSize="12" Click="OpenFile_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBox x:Name="SourceBox" Style="{StaticResource CodeBox}"
                                 TextChanged="SourceBox_TextChanged" />
                        <Grid x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False" Margin="1">
                            <Rectangle RadiusX="10" RadiusY="10" Margin="3"
                                       Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                       StrokeDashArray="4 3" Opacity="0.55" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="把代码文件拖到这里" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" Opacity="0.9" />
                                <TextBlock Text="也可以直接输入代码，或点击右上角「打开文件」"
                                           Style="{StaticResource Muted}" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="DropHintPath" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Text="支持 .py  .js  .ts  .cs  .java  .cpp" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 结果 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="转换结果" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ResultMeta" Grid.Column="1" Style="{StaticResource Muted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" Text="等待转换" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="复制" Style="{StaticResource GhostButton}" Padding="10,5"
                                    FontSize="12" Margin="0,0,6,0" Click="Copy_Click" />
                            <Button Content="另存为" Style="{StaticResource GhostButton}" Padding="10,5"
                                    FontSize="12" Click="SaveAs_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="ResultBox" Grid.Row="1" Style="{StaticResource CodeBox}"
                             IsReadOnly="True" />
                </Grid>
            </Border>
        </Grid>

        <!-- 转换提示 -->
        <Border x:Name="NotesPanel" Grid.Row="3" Style="{StaticResource Card}"
                Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="转换提示" Style="{StaticResource H2}" FontSize="13" />
                    <TextBlock x:Name="NotesCount" Style="{StaticResource Muted}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NotesList" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
