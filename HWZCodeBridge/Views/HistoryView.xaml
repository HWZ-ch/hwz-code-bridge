<UserControl x:Class="HWZCodeBridge.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="转换记录" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                       Text="记录每一次代码互换与编译打包，最多保留 500 条，可在设置中关闭。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Text="搜索文件名、转换路径或状态…" IsHitTestVisible="False"
                               Margin="13,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <ComboBox x:Name="KindBox" Grid.Column="1" Width="132" Margin="10,0,0,0"
                          Style="{StaticResource ModernCombo}" SelectionChanged="KindBox_SelectionChanged">
                    <ComboBoxItem Content="全部类型" Tag="all" />
                    <ComboBoxItem Content="代码互换" Tag="convert" />
                    <ComboBoxItem Content="编译产物" Tag="build" />
                </ComboBox>

                <Button Grid.Column="2" Content="导出 CSV" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Click="Export_Click" />

                <Button Grid.Column="3" Content="清空记录" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Click="Clear_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="RecordList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource RecordItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 类型徽标 -->
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,14,2"
                                    Background="{DynamicResource AccentBrush}" />

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding KindText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TimeText}" FontSize="11.5" Margin="10,1,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RouteText}" FontSize="11.5" Margin="10,1,0,0"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>

                                <TextBlock Text="{Binding SourceName}" FontSize="12" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,3,0,0"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status}" FontSize="11.5" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding DurationText}" FontSize="11" Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="删除" Style="{StaticResource GhostButton}" Padding="8,3"
                                        FontSize="11" Margin="0,6,0,0" Click="DeleteOne_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="还没有记录。完成一次代码互换或编译后会出现在这里。" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
