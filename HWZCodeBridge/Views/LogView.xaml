<UserControl x:Class="HWZCodeBridge.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="BUG 日志" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="程序运行、转换、打包的全过程都会记录到本地日志。遇到问题时可一键导出诊断报告，便于定位与反馈。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="级别" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />

                <ComboBox x:Name="LevelBox" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                          Style="{StaticResource ModernCombo}" SelectionChanged="LevelBox_SelectionChanged">
                    <ComboBoxItem Content="全部" IsSelected="True" Tag="all" />
                    <ComboBoxItem Content="仅警告与错误" Tag="warn" />
                    <ComboBoxItem Content="仅错误" Tag="error" />
                </ComboBox>

                <Button Grid.Column="2" Content="刷新" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Click="Refresh_Click" />
                <Button Grid.Column="3" Content="打开日志目录" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Click="OpenFolder_Click" />
                <Button Grid.Column="4" Content="导出诊断报告" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" Click="Export_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <TextBox x:Name="LogText" Style="{StaticResource CodeBox}" IsReadOnly="True" FontSize="12" />
        </Border>

        <TextBlock x:Name="StatText" Grid.Row="3" Style="{StaticResource Muted}" Margin="2,10,0,0" />
    </Grid>
</UserControl>
