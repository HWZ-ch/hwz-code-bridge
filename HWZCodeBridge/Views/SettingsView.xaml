<UserControl x:Class="HWZCodeBridge.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="设置" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                       Text="所有改动即时保存到本地，下次启动自动恢复。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

                <!-- 外观 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主题" Style="{StaticResource BaseText}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      Style="{StaticResource ModernCombo}" SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="浅色 · 清新" Tag="Light" IsSelected="True" />
                                <ComboBoxItem Content="深色 · 夜间" Tag="Dark" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="代码字号" Style="{StaticResource BaseText}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="FontSlider" Grid.Column="1" Minimum="11" Maximum="20"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="FontSlider_ValueChanged" />
                            <TextBlock x:Name="FontValue" Grid.Column="2" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" Text="13 px" />
                        </Grid>

                        <CheckBox x:Name="WrapCheck" Style="{StaticResource ModernCheck}"
                                  Content="代码自动换行" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />
                    </StackPanel>
                </Border>

                <!-- 行为 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="行为" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <CheckBox x:Name="HistoryCheck" Style="{StaticResource ModernCheck}" Margin="0,0,0,10"
                                  Content="保存转换与编译记录（最多 500 条）"
                                  Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />

                        <CheckBox x:Name="RememberCheck" Style="{StaticResource ModernCheck}" Margin="0,0,0,10"
                                  Content="记住上次选择的源语言与目标语言"
                                  Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />

                        <CheckBox x:Name="CopyCheck" Style="{StaticResource ModernCheck}" Margin="0,0,0,10"
                                  Content="转换完成后自动把结果复制到剪贴板"
                                  Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />

                        <CheckBox x:Name="ConfirmCheck" Style="{StaticResource ModernCheck}"
                                  Content="打包前显示确认对话框"
                                  Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />
                    </StackPanel>
                </Border>

                <!-- 编译 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="编译" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <TextBlock Text="默认输出目录" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" Grid.Column="0" Style="{StaticResource FieldBox}"
                                     LostFocus="OutputBox_LostFocus" />
                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource GhostButton}"
                                    Padding="12,7" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                        </Grid>

                        <TextBlock Text="默认目标架构" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <ComboBox x:Name="ArchBox" Width="240" HorizontalAlignment="Left"
                                  Style="{StaticResource ModernCombo}" SelectionChanged="ArchBox_SelectionChanged">
                            <ComboBoxItem Content="win-x64（64 位）" Tag="win-x64" IsSelected="True" />
                            <ComboBoxItem Content="win-x86（32 位）" Tag="win-x86" />
                            <ComboBoxItem Content="win-arm64（ARM64）" Tag="win-arm64" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="数据与维护" Style="{StaticResource H2}" Margin="0,0,0,10" />

                        <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开数据目录" Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0" Click="OpenData_Click" />
                            <Button Content="恢复默认设置" Style="{StaticResource GhostButton}" Click="Reset_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
