<UserControl x:Class="HWZCodeBridge.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="工具中心" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="本软件不内置任何编译器，全部通过命令行调用本机的第三方工具。下面每个工具都标注了来源组织、官方主页与许可证，便于核对与合规审计。" />
        </StackPanel>

        <!-- 提示条 -->
        <Border Grid.Row="1" Padding="14,10" Margin="0,0,0,12" CornerRadius="10"
                Background="{DynamicResource AccentSoftBrush}" BorderThickness="0">
            <TextBlock Style="{StaticResource BaseText}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="许可证说明：工具的开源许可证以各自官方页面为准。若你计划分发包含这些工具产物的软件，请先确认对应的许可证义务。" />
        </Border>

        <!-- 工具条 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText" Grid.Column="0" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Text="正在检测本机工具…" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="重新检测" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Rescan_Click" />
                <Button Content="添加自定义工具" Style="{StaticResource PrimaryButton}" Click="ToggleAddForm_Click" />
            </StackPanel>
        </Grid>

        <!-- 列表 + 添加表单 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox x:Name="ToolList" Grid.Row="0" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource RecordItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="10,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Detected}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Text="{Binding Purpose}" FontSize="12" Margin="0,5,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                                <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="来源：" /><Run Text="{Binding SourceNote, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Homepage, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="许可证：" /><Run Text="{Binding License, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="官网" Style="{StaticResource GhostButton}" Padding="10,5"
                                        FontSize="12" Margin="0,0,6,0" Click="OpenHomepage_Click" />
                                <Button Content="指定路径" Style="{StaticResource GhostButton}" Padding="10,5"
                                        FontSize="12" Margin="0,0,6,0" Click="SetPath_Click" />
                                <Button Content="移除" Style="{StaticResource GhostButton}" Padding="10,5"
                                        FontSize="12" Click="Remove_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 自定义工具表单 -->
            <Border x:Name="AddForm" Grid.Row="1" Style="{StaticResource Card}" Padding="16"
                    Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="添加第三方工具" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="名称、来源、可执行文件名必填。来源可以是官方主页或来源组织，用于追溯第三方工具的出处。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="名称 *" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtName" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="来源组织" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtSource" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                            <TextBlock Text="官方主页" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtHome" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="可执行文件名 *" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtExe" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="版本参数" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtArgs" Style="{StaticResource FieldBox}" Text="--version" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                            <TextBlock Text="许可证" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtLicense" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="用途说明" Style="{StaticResource Muted}" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtPurpose" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1">
                            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Click="ToggleAddForm_Click" />
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="SaveCustom_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
