<Window x:Class="HWZCodeBridge.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Height="540" Width="640"
        MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Top">
                <TextBlock Text="↑" Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="19" Text="发现新版本" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 版本对比 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" MinWidth="120">
                    <TextBlock Text="当前版本" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurrentVersionText" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Text="→" FontSize="20" Margin="26,10" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />

                <StackPanel HorizontalAlignment="Center" MinWidth="120">
                    <TextBlock Text="最新版本" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LatestVersionText" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>

                <Border Width="1" Background="{DynamicResource LineBrush}" Margin="26,4" />

                <StackPanel HorizontalAlignment="Center" MinWidth="110">
                    <TextBlock Text="安装包大小" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SizeText" FontSize="14" Margin="0,7,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 更新说明 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="更新内容" Style="{StaticResource H2}" Margin="0,0,0,8" />
                <TextBox x:Name="NotesBox" Style="{StaticResource CodeBox}" IsReadOnly="True"
                         FontFamily="{DynamicResource UiFont}" FontSize="12.5" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- 进度 -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
                <TextBlock x:Name="PercentText" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar x:Name="DownloadBar" Height="6" Minimum="0" Maximum="100"
                         Background="{DynamicResource SurfaceAltBrush}"
                         Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0" />
        </StackPanel>

        <!-- 按钮 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SkipBtn" Grid.Column="0" Content="跳过此版本" Style="{StaticResource GhostButton}"
                    Padding="12,8" FontSize="12.5" Click="Skip_Click" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="LaterBtn" Content="稍后提醒" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="Later_Click" />
                <Button x:Name="UpdateBtn" Content="立即更新" Style="{StaticResource PrimaryButton}"
                        Click="Update_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
